# Local development defaults for the monitoring stack.
#
# Copy to .env and adjust. `.env` is gitignored; only this example is tracked.
#   cp .env.example .env
#
# docker compose reads .env automatically. Python code reads the same variable
# names from the environment, so `make alerts` and `make mcp-verify` pick them up
# when .env is exported (or when compose passes them into a container).
#
# These are placeholders for a stack bound to localhost. They protect nothing
# reachable from outside the machine -- the point of moving them here is that a
# public repository should not ship even placeholder credentials inline, and that
# a real deployment has one obvious place to override them.

# --- Postgres: alert history for the MCP server ---
POSTGRES_USER=swakde
POSTGRES_PASSWORD=change-me
POSTGRES_DB=swakde
POSTGRES_PORT=5432

# Connection string used by mcp_server/store.py. Must agree with the values
# above. Inside a container the host is `postgres`; from the host it is
# `localhost`.
POSTGRES_DSN=postgresql://swakde:change-me@localhost:5432/swakde

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Kafka / replay (optional; defaults in streaming/config.py are fine) ---
# KAFKA_BOOTSTRAP=localhost:9092
# KAFKA_TOPIC=metropt.sensors
# REPLAY_SPEEDUP=1000

# --- Sketch parameters (optional; see streaming/config.py) ---
# SKETCH_ROWS=400
# SKETCH_K=3
# SKETCH_WINDOW=3600
